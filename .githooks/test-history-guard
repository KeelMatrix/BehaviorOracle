#!/bin/sh
set -eu

fail() {
  printf 'History guard regression failed: %s\n' "$1" >&2
  exit 1
}

require_command() {
  required_command=$1
  if ! command -v "$required_command" >/dev/null 2>&1; then
    fail "required command \"$required_command\" was not found in PATH"
  fi
}

for required_command in git dirname mktemp rm mkdir cp chmod cat; do
  require_command "$required_command"
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
shell_path=$(command -v sh) || fail 'sh was not found in PATH'
original_path=${PATH:-}
temporary_root=$(mktemp -d "${TMPDIR:-/tmp}/history-guard-regression.XXXXXX")
trap 'rm -rf "$temporary_root"' EXIT HUP INT TERM

shadow_bin=$temporary_root/shadow-bin
mkdir "$shadow_bin"
printf '%s\n' '#!/bin/sh' 'exit 127' > "$shadow_bin/grep"
chmod +x "$shadow_bin/grep"
shadow_path=$shadow_bin:$original_path

message_file=$temporary_root/invalid-message.txt
diagnostics=$temporary_root/diagnostics.txt
printf '%s\n' 'Generated by agent' > "$message_file"

if PATH="$shadow_path" "$shell_path" "$script_dir/commit-msg" "$message_file" > /dev/null 2>"$diagnostics"; then
  fail 'commit-msg accepted an invalid message when grep could not execute'
else
  hook_status=$?
fi
if [ "$hook_status" -eq 0 ]; then
  fail 'commit-msg returned success when grep could not execute'
fi
case "$(cat "$diagnostics")" in
  *grep*) ;;
  *) fail 'commit-msg did not report the missing grep dependency' ;;
esac

repository=$temporary_root/repository
mkdir "$repository"
git -C "$repository" init --initial-branch=main >/dev/null
git -C "$repository" config user.name KeelMatrix
git -C "$repository" config user.email keelmatrix@gmail.com
git -C "$repository" commit --allow-empty -m 'Initial repository state' >/dev/null
mkdir "$repository/.githooks"
cp "$script_dir/commit-msg" "$repository/.githooks/commit-msg"
cp "$script_dir/check-history" "$repository/.githooks/check-history"
chmod +x "$repository/.githooks/commit-msg" "$repository/.githooks/check-history"
git -C "$repository" config core.hooksPath .githooks

before_count=$(git -C "$repository" rev-list --count HEAD)
if PATH="$shadow_path" git -C "$repository" commit --allow-empty -m 'Generated by agent' > /dev/null 2>"$diagnostics"; then
  fail 'Git created an invalid commit when grep could not execute'
else
  commit_status=$?
fi
after_count=$(git -C "$repository" rev-list --count HEAD)
if [ "$commit_status" -eq 0 ] || [ "$after_count" != "$before_count" ]; then
  fail "invalid commit was not rejected without changing history (status=$commit_status, before=$before_count, after=$after_count)"
fi

if PATH="$original_path" git -C "$repository" commit --allow-empty -m 'Generated by agent' > /dev/null 2>"$diagnostics"; then
  fail 'commit-msg accepted an invalid message with normal utilities'
else
  invalid_status=$?
fi
after_invalid_count=$(git -C "$repository" rev-list --count HEAD)
if [ "$invalid_status" -eq 0 ] || [ "$after_invalid_count" != "$before_count" ]; then
  fail "invalid message regression did not reject without changing history (status=$invalid_status, before=$before_count, after=$after_invalid_count)"
fi

if (cd "$repository" && PATH="$shadow_path" "$shell_path" "$script_dir/check-history") > /dev/null 2>"$diagnostics"; then
  fail 'check-history accepted reachable history when grep could not execute'
else
  history_status=$?
fi
if [ "$history_status" -eq 0 ]; then
  fail 'check-history returned success when grep could not execute'
fi

missing_helper_dir=$temporary_root/missing-helper
mkdir "$missing_helper_dir"
cp "$script_dir/check-history" "$missing_helper_dir/check-history"
chmod +x "$missing_helper_dir/check-history"
if (cd "$repository" && "$shell_path" "$missing_helper_dir/check-history") > /dev/null 2>"$diagnostics"; then
  fail 'check-history accepted a missing commit-msg helper'
else
  helper_status=$?
fi
if [ "$helper_status" -eq 0 ]; then
  fail 'check-history returned success with a missing commit-msg helper'
fi
case "$(cat "$diagnostics")" in
  *commit-msg*) ;;
  *) fail 'check-history did not report its missing commit-msg helper' ;;
esac

PATH="$original_path" git -C "$repository" commit --allow-empty -m 'Harden history guard' >/dev/null
if ! (cd "$repository" && PATH="$original_path" "$shell_path" "$script_dir/check-history") > /dev/null; then
  fail 'check-history rejected clean reachable history'
fi

printf '%s\n' 'History guard regression passed: invalid messages reject, missing dependencies fail closed, and valid history passes.'
